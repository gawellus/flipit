{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flipit",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  // Ping Supabase every 3 days to prevent free-tier project pausing
  "triggers": {
    "crons": ["0 0 */3 * *"],
  },
}
