---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar";

const { user } = Astro.locals;
---

<Layout title="Dashboard">
  <Topbar client:load user={user ? { email: user.email ?? "" } : null} pathname="/dashboard" />
  <main class="mx-auto max-w-[1120px] px-6 py-8">
    <p class="text-muted-foreground">
      Welcome, <span class="text-fi-ink font-medium">{user?.email}</span>
    </p>
    <p class="text-muted-foreground mt-2 text-sm">Dashboard content coming in Phase 4.</p>
  </main>
</Layout>
