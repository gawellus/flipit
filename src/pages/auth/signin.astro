---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar";
import { GradientMesh } from "@/components/GradientMesh";
import { Logo } from "@/components/Logo";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in">
  <Topbar client:load user={null} pathname="/auth/signin" variant="marketing" />
  <div class="relative flex min-h-[calc(100vh-64px)] items-center justify-center p-4">
    <GradientMesh client:load style={{ height: "340px" }} />
    <div
      class="relative z-10 w-full max-w-[440px] rounded-2xl border border-[var(--fi-hairline)] bg-white p-9 shadow-[var(--shadow-float)]"
    >
      <div class="mb-6 flex justify-center">
        <Logo size={36} showWordmark={false} />
      </div>
      <h1 class="text-fi-ink mb-1 text-center text-2xl font-light">Welcome back</h1>
      <p class="text-muted-foreground mb-6 text-center text-sm">Sign in to keep your streak going.</p>
      <SignInForm serverError={error} client:load />
      <p class="text-muted-foreground mt-6 text-center text-sm">
        Don't have an account? <a href="/auth/signup" class="text-primary hover:text-fi-primary-deep font-medium"
          >Sign up</a
        >
      </p>
    </div>
  </div>
</Layout>
